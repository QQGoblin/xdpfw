#!/usr/bin/env python3

import os
import shutil
import subprocess
import sys


SERVICE = "xfw.service"
NAMESPACE_BIN_DIR = "/opt/tempesta/bin"
NAMESPACE_PATH = (
    "/opt/tempesta/bin:/opt/tempesta/sbin:/usr/local/sbin:/usr/local/bin:"
    "/usr/sbin:/usr/bin:/sbin:/bin"
)
RESTRICTED_XFWCTL_ACTIONS = frozenset((
    "--start", "--stop", "--restart",
    "--start-mgr", "--stop-mgr", "--restart-mgr",
    "--load-bpf", "--unload-bpf", "--reload-bpf",
))

SYSTEMCTL_BIN = shutil.which("systemctl")
NSENTER_BIN = shutil.which("nsenter")

def command(cmd, timeout=10, capture=True, env=None):
    """
        执行 shell 命令
    :param cmd:
    :param capture: 是否捕获输出，False 时直接输出到终端
    :param env: 子进程环境变量
    :return:
    """

    stream = subprocess.PIPE if capture else None
    proc = subprocess.run(cmd, stdout=stream, stderr=stream, universal_newlines=True,
                          timeout=timeout, env=env)
    if proc.returncode != 0:
        raise RuntimeError("run {} failed, return code: {}, stderr: {}".format(
            " ".join(cmd), proc.returncode, (proc.stderr or "").strip()))
    return proc.stdout.strip() if proc.stdout is not None else ""


def service_pid(name):
    """
        获取服务的主进程 PID
    :param service:
    :return:
    """
    try:
        output = command([SYSTEMCTL_BIN, "show", "--no-pager", "-p", "ActiveState", "-p", "MainPID", name])
    except RuntimeError as exc:
        raise RuntimeError("cannot query {}: {}".format(name, exc))

    properties = dict(line.split("=", 1) for line in output.splitlines() if "=" in line)
    pid = properties.get("MainPID", "0")
    state = properties.get("ActiveState", "unknown")

    if state != "active" or not pid.isdigit() or int(pid) <= 0:
        raise RuntimeError("{} is not running, state: {}".format(name, state))
    
    return pid


def main(args):
    if not args:
        print("Usage: {} [arguments...]".format(sys.argv[0]), file=sys.stderr)
        return 2
   
    invoked_name = os.path.basename(sys.argv[0])
    if invoked_name == "xfwctl":
        options = iter(args)
        for option in options:
            if option in ("-c", "--config"):
                next(options, None)
            elif option in RESTRICTED_XFWCTL_ACTIONS:
                print("{} is disabled in the host wrapper; use systemctl to control {}.".format(option, SERVICE), file=sys.stderr)
                return 2

    executable = os.path.join(NAMESPACE_BIN_DIR, invoked_name)
    xfw_pid = service_pid(SERVICE)
    environment = {"PATH": NAMESPACE_PATH}
    command([NSENTER_BIN, "--target", xfw_pid, "--mount", "--root", "--wd", "--", executable] + args,
            capture=False, env=environment)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
